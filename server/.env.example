NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://asel:asel-dev-password@localhost:27017/asel?authSource=admin

# Auth
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
SECRET_ENCRYPTION_KEY=replace-with-a-different-long-random-string-at-least-32-chars
JWT_EXPIRES=12h
BCRYPT_ROUNDS=12

# Cookies
# In production this should remain true unless you terminate TLS elsewhere intentionally.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:5173

# OCR
# Mistral OCR is the premium provider when MISTRAL_API_KEY is set.
# Local PaddleOCR/ONNX remains enabled as fallback and does not use Tesseract.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
OCR_LOCAL_ENABLED=true
OCR_PREPROCESS_MAX_EDGE=2600

# Daily Mongo JSON ZIP backups, no uploaded images/files.
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_FILES=30
BACKUP_MAX_TOTAL_MB=512

# Siege pointage geofence
SIEGE_NAME=ASEL Siege
SIEGE_LAT=36.8065
SIEGE_LNG=10.1815
SIEGE_RADIUS_METERS=300

# Seed (used by `npm run seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMeNow!2024
SEED_SHARED_PASSWORD=ChangeAllSeededUsersNow!2024
