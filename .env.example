# Docker Compose dev stack
MONGO_ROOT_USER=asel
MONGO_ROOT_PASSWORD=asel-dev-password
MONGO_DB=asel
MONGODB_URI=mongodb://asel:asel-dev-password@mongo:27017/asel?authSource=admin

JWT_SECRET=asel-dev-jwt-secret-change-me-1234567890
SECRET_ENCRYPTION_KEY=asel-dev-secret-encryption-key-change-me-1234567890
JWT_EXPIRES=12h
BCRYPT_ROUNDS=10

COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=*

MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
OCR_LOCAL_ENABLED=true
OCR_PREPROCESS_MAX_EDGE=2600

BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_FILES=30
BACKUP_MAX_TOTAL_MB=512

SIEGE_NAME=ASEL Siege
SIEGE_LAT=36.8065
SIEGE_LNG=10.1815
SIEGE_RADIUS_METERS=300

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=AdminDev123!
SEED_SHARED_PASSWORD=UserDev123!

CLIENT_PORT=5173
API_PORT=4000
MONGO_PORT=27017
CHOKIDAR_USEPOLLING=true

# Optional named Cloudflare Tunnel. Keep asel.saleheddinetouil.tech for VPS;
# local development should normally use the random dev-tunnel URL.
CLOUDFLARED_TOKEN=
