{
  "name": "asel-mobile-pointage",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start --clear",
    "start:cloudflare": "expo start --tunnel --port 8081 --clear",
    "start:tunnel": "expo start --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.34",
    "expo-application": "~7.0.8",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "latest"
  }
}
