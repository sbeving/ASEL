{
  "name": "asel-mobile-pointage",
  "version": "0.1.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start --clear",
    "start:cloudflare": "expo start --tunnel --port 8081 --clear",
    "start:tunnel": "expo start --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:apk": "npx eas-cli build --platform android --profile preview",
    "build:android:dev": "npx eas-cli build --platform android --profile development",
    "build:android:local-apk": "cd android && ./gradlew assembleRelease",
    "build:android:vps-apk": "EXPO_PUBLIC_API_BASE_URL=https://asel.saleheddinetouil.tech/api npm run build:android:local-apk",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.7",
    "expo-application": "~7.0.8",
    "expo-camera": "~17.0.10",
    "expo-device": "~8.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.86.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "latest"
  }
}
